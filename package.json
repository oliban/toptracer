{
  "name": "toptracer-range-analyzer",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["packages/server", "packages/web"],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev -w packages/server\" \"npm:dev -w packages/web\"",
    "build": "npm run build -w packages/server && npm run build -w packages/web",
    "test": "npm run test -w packages/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
